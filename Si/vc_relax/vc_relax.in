 &CONTROL
   calculation     = 'vc-relax' 
   restart_mode    = 'from_scratch' 
   outdir          = './temp/' 
   pseudo_dir      = './../../pseudos/' 
   prefix          = 'silicon' 
   verbosity       = 'high' 
   etot_conv_thr   = 1.0D-5 
   forc_conv_thr   = 1.0D-4 
 /
 &SYSTEM
   ibrav           = -5
   A               = 3.85 
   cosAB           = 0.5 
   nat             = 2
   ntyp            = 1
   ecutwfc         = 45 
   occupations     = 'smearing' 
   degauss         = 0.0005 
   smearing        = 'gaussian' 
 /
 &ELECTRONS
   conv_thr        = 1.0D-8 
 /
 &IONS
 /
 &CELL
   cell_dofree     = 'ibrav' 
   press_conv_thr  = 1.0D-1 
 /
ATOMIC_SPECIES
   Si   28.08550  Si.pbesol-n-kjpaw_psl.1.0.0.UPF 
ATOMIC_POSITIONS crystal 
   Si      0.750000000    0.750000000    0.750000000    
   Si      0.500000000    0.500000000    0.500000000    
K_POINTS automatic 
  7 7 7   0 0 0 

